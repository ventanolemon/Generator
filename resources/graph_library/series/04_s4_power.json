        "params": {
          "text": "R = #R#. Интервал: (#lo#; #hi#]. При x = #hi#: Σ(−1)ⁿ/(#a#n+#b#) — сходится условно (Лейбниц); при x = #lo#: Σ1/(#a#n+#b#) — расходится (гармонический). Равномерно: на [c; #hi#] при любом c > #lo# (Абель)."
        }
      },
      {
        "id": "a1",
        "type": "text",
        "params": {
          "text": "R = #R#. Интервал: [#lo#; #hi#). При x = #lo#: Σ(−1)ⁿ/(#a#n+#b#) — сходится условно (Лейбниц); при x = #hi#: Σ1/(#a#n+#b#) — расходится. Равномерно: на [#lo#; c] при любом c < #hi# (Абель)."
        }
      },
      {
        "id": "a2",
        "type": "text",
        "params": {
          "text": "R = #R#. Сходится на всём отрезке [#lo#; #hi#]: на концах Σ(±1)ⁿ/(#a#n²+#b#) сходится абсолютно (p-ряд, s = 2). Равномерно на всём [#lo#; #hi#] (Вейерштрасс, Mₙ = 1/(#a#n²+#b#))."
        }
      },
      {
        "id": "a3",
        "type": "text",
        "params": {
          "text": "R = #R#. Интервал: (#lo#; #hi#) — на обоих концах aₙ = ±n ↛ 0, ряд расходится. Равномерно на любом [α; β] ⊂ (#lo#; #hi#); на всём интервале — нет."
        }
      },
