__pycache__/
*.py[cod]
sim_results/

# Локальные резервные копии БД (создаются seed-скриптом перед записью)
resources/*.db.bak-*

# Claude Code local tooling (agent worktrees, session settings)
.claude/

# Хвосты журнала SQLite. Файл БД в режиме WAL неполон без них, и попасть
# в коммит они не должны никогда: поставочная БД с чужим -wal на другой
# машине может не открыться.
resources/*.db-wal
resources/*.db-shm
resources/*.db-journal

# Данные запуска. `resources/` — ПОСТАВКА (словари, звук, шаблон базы), она
# версионируется. `data/` — то, что накопила ОДНА установка: рабочая база,
# созданная копией шаблона при первом старте (`const.ensure_data_dir`).
data/
